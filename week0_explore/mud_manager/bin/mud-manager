#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require_relative "../lib/mud_manager"

options = {
  host:     MudManager::Session::DEFAULT_HOST,
  port:     MudManager::Session::DEFAULT_PORT,
  timeout:  MudManager::Session::DEFAULT_TIMEOUT,
  name:     ENV["MUD_NAME"],
  password: ENV["MUD_PASSWORD"]
}

OptionParser.new do |opts|
  opts.banner = "Usage: mud-manager [options]\n\nOpens an interactive raw-command prompt against a CircleMUD server."

  opts.on("--host HOST", "MUD host (default: #{options[:host]})") { |v| options[:host] = v }
  opts.on("--port PORT", Integer, "MUD port (default: #{options[:port]})") { |v| options[:port] = v }
  opts.on("--timeout SECONDS", Float, "Read timeout in seconds (default: #{options[:timeout]})") { |v| options[:timeout] = v }
  opts.on("--name NAME", "Character name to log in as (default: $MUD_NAME)") { |v| options[:name] = v }
  opts.on("--password PASSWORD", "Character password (default: $MUD_PASSWORD)") { |v| options[:password] = v }
  opts.on("-h", "--help", "Show this help") do
    puts opts
    exit
  end
end.parse!

session = MudManager::Session.new(host: options[:host], port: options[:port], timeout: options[:timeout])

begin
  session.open
rescue MudManager::Session::ConnectionError => e
  warn "mud-manager: #{e.message}"
  exit 1
end

puts "Connected to #{options[:host]}:#{options[:port]}."

if options[:name] && options[:password]
  begin
    session.login(options[:name], options[:password])
    puts "Logged in as #{options[:name]}."
  rescue MudManager::Session::LoginError => e
    warn "mud-manager: login failed: #{e.message}"
    session.close
    exit 1
  end
else
  print session.read_until_quiet(0.5)
end

puts "Type raw MUD commands (including 'quit' to leave the game). Ctrl-D disconnects the client."

begin
  loop do
    print "> "
    $stdout.flush

    line = $stdin.gets
    break if line.nil?

    line = line.chomp
    next if line.empty?

    session.send_command(line)
    output = session.read_until_quiet(0.5)
    puts output unless output.empty?
  end
rescue Interrupt
  puts
ensure
  session.close if session.open?
  puts "Disconnected."
end

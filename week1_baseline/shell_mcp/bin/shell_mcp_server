#!/usr/bin/env ruby
# frozen_string_literal: true

# A real MCP (Model Context Protocol) server over stdio exposing a
# run_command tool, sandboxed to a working directory. See
# docs/plans/mud_manager/mcp_mud_plan.md -- same rationale as
# file_system_mcp: no language's agent needs its own shell tool
# implementation, every language reaches this one generically.
#
# Config comes from the environment:
#   WORKING_DIR       (required) -- commands run with this as their cwd
#   SHELL_TIMEOUT     (default "30") -- seconds before a command is killed
#   ALLOWED_COMMANDS  (optional) -- comma-separated executable allow-list;
#                     unset means every command is permitted

require "boukensha"
require_relative "../lib/shell_tools"

ctx      = Boukensha::Context.new(task: nil)
registry = Boukensha::Registry.new(ctx)

allowed = ENV["ALLOWED_COMMANDS"]

ShellTools.register(
  registry,
  working_dir:      ENV.fetch("WORKING_DIR") { abort "shell_mcp_server: WORKING_DIR is required" },
  timeout:          Integer(ENV.fetch("SHELL_TIMEOUT", "30")),
  allowed_commands: (allowed && !allowed.strip.empty?) ? allowed.split(",").map(&:strip) : nil
)

warn "[shell_mcp_server] ready — #{ctx.tool_count} tools registered"

Boukensha::MCP::Server.new(registry, name: "shell_mcp", version: "0.1.0").serve
